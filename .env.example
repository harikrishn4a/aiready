# Copy this file to .env and fill in the key for your chosen provider.
# Only one key is needed — whichever provider you select at runtime.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: redirect OpenAI provider to any OpenAI-compatible endpoint
# (Groq, Azure OpenAI, Together, local proxy, etc.)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional: override Ollama host (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Optional: set Ollama model (default: llama3)
# OLLAMA_MODEL=llama3
