{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature List",
  "description": "Machine-readable feature tracker. Maintained by agent. Narrative spec lives in features.md.",
  "type": "object",
  "required": ["project", "last_updated", "features"],
  "properties": {
    "project": {
      "type": "string",
      "description": "Project name"
    },
    "last_updated": {
      "type": "string",
      "description": "YYYY-MM-DD date of last update"
    },
    "rules": {
      "type": "object",
      "properties": {
        "single_active_feature": { "type": "boolean" },
        "passing_requires_evidence": { "type": "boolean" },
        "do_not_skip_verification": { "type": "boolean" }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique feature identifier (e.g. feat-001)",
            "pattern": "^feat-\\d+$"
          },
          "priority": {
            "type": "integer",
            "description": "Lower number = higher priority"
          },
          "area": {
            "type": "string",
            "description": "Functional area or module"
          },
          "title": {
            "type": "string",
            "description": "Short feature name"
          },
          "user_visible_behavior": {
            "type": "string",
            "description": "What the user sees when this feature is complete"
          },
          "status": {
            "type": "string",
            "enum": ["not_started", "in_progress", "blocked", "passing"],
            "description": "Current implementation state"
          },
          "blocked_reason": {
            "type": "string",
            "description": "Required when status is blocked — what is preventing progress"
          },
          "verification": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Steps to verify this feature is complete"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Verification output recorded by agent when status moves to passing"
          },
          "agent_notes": {
            "type": "string",
            "description": "Implementation notes added by agent during work"
          },
          "last_updated": {
            "type": "string",
            "description": "YYYY-MM-DD date agent last modified this entry"
          }
        }
      }
    }
  }
}